#:import hex kivy.utils.get_color_from_hex


ScreenManager:
    MPA_Main:
    NumberGuess:
    Converter:
    # Loser:

<MPA_Main>:
    name: 'MPA_Main'
    MDBoxLayout:
        orientation: "vertical"
        spacing: 20

        MDToolbar:
            title: "Welcome to MPA !!!"
            halign:"left"
            pos_hint: {"top":1}
            md_bg_color: hex('#008080')
            specific_text_color: hex('#FFFFFF')
            elevation: 10   

        MDLabel:
            text: ""

        MDFillRoundFlatButton:
            text: "Number Guessing"
            halign:"left"
            theme_text_color: "Custom"
            text_color: 0, 0, 1, 1
            pos_hint: {"center_x": 0.1, "center_y":0.5}
            size_hint: None, None
            width: 10
            height:10
            on_release:
                root.manager.transition.duration = 0
                root.manager.current = 'NumberGuess'
                root.guesses_left = int(5)
                root.manager.get_screen('NumberGuess').LabelText = app.guess_text

        MDFillRoundFlatButton:
            text: "Converter"
            halign:"left"
            theme_text_color: "Custom"
            text_color: 0, 0, 1, 1
            pos_hint: {"center_x": 0.1, "center_y":0.5}
            size_hint: None, None
            width: 10
            height:10
            on_release:
                root.manager.transition.duration = 0
                root.manager.current = 'Converter'
                # root.manager.get_screen('Converter')


        MDFillRoundFlatButton:
            text: "Place Holder"
            halign:"left"
            theme_text_color: "Custom"
            text_color: 0, 0, 1, 1
            pos_hint: {"center_x": 0.1, "center_y":0.5}
            size_hint: None, None
            width: 10
            height:10
            on_release:
                root.manager.transition.duration = 0


        MDLabel:
            text: "Hi"
            size_hint: 0.7, None
            pos_hint: {"center_x": 0.5, "center_y":0.2}

<NumberGuess>:
    name: 'NumberGuess'
    
    MDBoxLayout:
        orientation: "vertical"

        MDToolbar:
            title: "Number Guessing Game"
            right_action_items: [["home", lambda _: setattr(root.manager, 'current', 'MPA_Main')]]
            md_bg_color: hex('#C46210')
            specific_text_color: hex('#FFFFFF')
            elevation: 10

        MDLabel:
            text: "Enter Any Number Between 1 to 50"
            halign: "center"
            theme_text_color: "Custom"
            text_color: 0, 0, 1, 1
            font_style: "H5"


        MDLabel:
            id: guesses_left
            text: root.LabelText
            theme_text_color: "Custom"
            text_color: "brown"
            halign:"center"
            size_hint: 0.3, 0.5
            pos_hint: {"center_x": 0.4, "center_y":0.5}


        MDTextField:
            id: input_num
            hint_text:"Enter Number"
            required: True
            max_text_length: 3
            mode:"round"
            size_hint: 0.25, 0.3
            pos_hint: {"center_x": 0.4, "center_y":0.5}
            
        
        MDLabel:
            text: ""
            size_hint_y: None
            height: 10


        MDBoxLayout:
            orientation: "horizontal"
            padding: ('200dp', '0dp', '0dp', '0dp')
            spacing:25
            MDFillRoundFlatButton:
                id:sub_button
                text: "Submit"
                halign:"center"
                theme_text_color: "Custom"
                text_color: hex('#000000')
                pos_hint: {"center_x": 0.3, "center_y":0.5}
                size_hint: None, None
                md_bg_color:hex('#3D9140')
                width: 10
                height:10
                disabled: False
                md_bg_color_disabled: hex('#808080')
                on_press:
                    root.check()
                # on_release:
                    app.guesses_left = int(app.guesses_left) - int(1)
                    root.LabelText = 'Guesses Remaining: ' + str(app.guesses_left)   
                

            MDFillRoundFlatButton:
                text: "Reset"
                halign:"right"
                theme_text_color: "Custom"
                text_color: 0, 0, 1, 1
                pos_hint: {"center_x": 0.8, "center_y":0.5}
                size_hint: None, None
                width: 10
                height:10
                on_release:
                    root.reset1()                
                    app.guesses_left = int(5)                    
            
  
        MDLabel:
            id: guess_msg
            text_color: hex('#3B7A57')
            size_hint: 0.7, None
            pos_hint: {"center_x": 0.5, "center_y":0.2}


<Converter>:
    name: 'Converter'
    MDBoxLayout:
        orientation: "vertical"
        spacing: 10

        MDToolbar:
            id: convert_toolbar
            title: "Binary to Decimal"
            # right_action_items: [["menu"],["home", lambda _: setattr(root.manager, 'current', 'MPA_Main')]]
            # ["rotate-3d-variant", lambda x: self.flip()]
            md_bg_color: hex('#EFDECD')
            specific_text_color: hex('#00308F')
            elevation: 10

        MDLabel:
            text: ""
            size_hint_y: None
            height: 10

        MDTextField:
            id: input_bin
            # hint_text:"enter a binary number"
            max_text_length: 10
            halign:"center"
            size_hint: (0.8,1)
            pos_hint: {"center_x": 0.5, "center_y":0.5}
            font_size: 22

        MDLabel:
            id: sec_label
            halign:"center"
            text_color: hex('#EFDECD')
            size_hint: 0.7, None
            pos_hint: {"center_x": 0.5, "center_y":0.2}
            theme_text_color: "Secondary"
            font_style: "H5"

        MDLabel:
            id: prim_label
            halign:"center"
            text_color: hex('#EFDECD')
            size_hint: 0.7, None
            pos_hint: {"center_x": 0.5, "center_y":0.2}
            theme_text_color: "Primary"
            font_style: "H5"

        MDFillRoundFlatButton:
            text: "CONVERT"
            halign:"center"
            theme_text_color: "Custom"
            text_color: 0, 0, 1, 1
            pos_hint: {"center_x": 0.5, "center_y":0.5}
            size_hint: None, None
            width: 10
            height:10
            on_release:
                root.convert()    


        MDFloatingActionButtonSpeedDial:
            id: spd_dial_btn
            data: {'Home':'home','Flip':'rotate-3d-variant'}
            root_button_anim: True
            hint_animation: True
            label_text_color: 1,0,0,1
            bg_hint_color: 0,1,0,1
            bg_color_stack_button: 0,1,0,1
            #Pushing the buttons
            callback: root.call
                


        MDLabel:
            text: ""
            size_hint_y: None
            height: 10