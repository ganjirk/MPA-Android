<?xml version="1.0" encoding="utf-8"?>
<!--
   Used on Android 11 and older. The sign-in tokens are encrypted with a key that exists only on
   this device, so a restored copy would be useless. Keep them out of backups.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/auth.preferences_pb" />
</full-backup-content>
