<?xml version="1.0" encoding="utf-8"?>
<!--
   Used on Android 12 and newer. Keep the sign-in tokens out of cloud backups and device transfers:
   they are encrypted with a key that exists only on this device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/auth.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/auth.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
