#:import hex kivy.utils.get_color_from_hex
<root_layt>

    MDBoxLayout:
        id: guesses_left
        text: root.LabelText
        orientation: "vertical"

        MDToolbar:
            title: "Number Guessing Game"
            right_action_items: [["home", lambda x: app.callback()]]
            md_bg_color: hex('#008080')
            specific_text_color: hex('#FFFFFF')
            elevation: 10   

        MDLabel:
            text: "Enter Any Number Between 1 to 50"
            halign: "center"
            theme_text_color: "Custom"
            text_color: 0, 0, 1, 1
            font_style: "H5"


        MDLabel:
            text: "Total Number of Chances: 5"
            theme_text_color: "Custom"
            text_color: "brown"
            halign:"center"
            size_hint: 0.3, 0.5
            pos_hint: {"center_x": 0.4, "center_y":0.5}
        
        MDLabel:
            id: guesses_left
            text: root.LabelText
            theme_text_color: "Custom"
            text_color: "brown"
            halign:"center"
            size_hint: 0.3, 0.5
            pos_hint: {"center_x": 0.4, "center_y":0.5}


        MDTextField:
            id: input_num
            hint_text:"Enter Number"
            mode:"rectangle"
            size_hint: 0.3, 0.5
            pos_hint: {"center_x": 0.4, "center_y":0.5}
            
        
        MDLabel:
            text: ""
            size_hint_y: None
            height: 10


        MDBoxLayout:
            orientation: "horizontal"
            padding: ('200dp', '0dp', '0dp', '0dp')
            spacing:25
            MDFillRoundFlatButton:
                text: "Submit"
                halign:"center"
                theme_text_color: "Custom"
                text_color: hex('##000000')
                pos_hint: {"center_x": 0.3, "center_y":0.5}
                size_hint: None, None
                md_bg_color:hex('#3D9140')
                width: 10
                height:10
                on_press:
                    app.check()
                on_release:
                    app.guesses_left = int(app.guesses_left) - int(1)
                    root.LabelText = 'Guesses Left: ' + str(app.guesses_left)   

            MDFillRoundFlatButton:
                text: "Reset"
                halign:"right"
                theme_text_color: "Custom"
                text_color: 0, 0, 1, 1
                pos_hint: {"center_x": 0.8, "center_y":0.5}
                size_hint: None, None
                width: 10
                height:10
                on_press:app.reset1()
            
  
        MDLabel:
            id: guess_msg
            size_hint: 0.7, None
            pos_hint: {"center_x": 0.5, "center_y":0.2}

